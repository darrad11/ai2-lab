{% extends 'base.html.twig' %}

{% block title %}Lista przepisów{% endblock %}

{% block stylesheets %}
    {{ encore_entry_link_tags('app') }}
    <!-- Link do Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="mb-4">Przepisy</h1>

        <!-- Wyświetlanie przepisów -->
        <div class="row">
            {% for recipe in recipes %}
                <div class="col-md-4 mb-4">
                    <div class="card h-100">
                        <!-- Obraz przepisu -->
                        <img src="{{ asset(recipe.image) }}" alt="{{ recipe.name }}" class="card-img-top" style="height: 200px; object-fit: cover;">

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">{{ recipe.name }}</h5>
                            <p class="card-text text-truncate" style="max-height: 60px;">{{ recipe.description }}</p>
                            <p><strong>Widoki:</strong> {{ recipe.views }}</p>

                            <!-- Opcja dodania do ulubionych -->
                            <div class="mt-auto">
                                <a href="{{ path('recipe_favorite', { 'id': recipe.id }) }}" class="btn btn-outline-danger btn-sm mb-2">
                                    {% if isFavorite %}
                                        ❤️ Usuń z ulubionych
                                    {% else %}
                                        🤍 Dodaj do ulubionych
                                    {% endif %}
                                </a>

                                <!-- Link do szczegółów przepisu -->
                                <a href="{{ path('recipe_detail', { 'id': recipe.id }) }}" class="btn btn-primary btn-sm">Zobacz szczegóły</a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <p>Brak przepisów do wyświetlenia.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
